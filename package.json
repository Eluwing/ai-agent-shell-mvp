{
  "name": "ai-agent-mock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=10.9.0"
  },
  "dependencies": {
    "@langchain/core": "1.1.41",
    "@langchain/langgraph": "1.2.9",
    "@libsql/client": "0.17.3",
    "@radix-ui/react-slot": "1.2.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.11.0",
    "openai": "6.34.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tailwind-merge": "3.5.0",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.2.4",
    "@types/node": "22.19.17",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "concurrently": "9.2.1",
    "cross-env": "10.1.0",
    "electron": "41.3.0",
    "electron-builder": "26.8.1",
    "tailwindcss": "4.2.4",
    "typescript": "6.0.3",
    "vite": "8.0.10",
    "wait-on": "9.0.5"
  },
  "overrides": {
    "uuid": "14.0.0"
  },
  "build": {
    "appId": "com.aiagent.mock",
    "productName": "AI Agent Mock",
    "files": [
      "dist",
      "electron"
    ],
    "directories": {
      "output": "release"
    }
  }
}
